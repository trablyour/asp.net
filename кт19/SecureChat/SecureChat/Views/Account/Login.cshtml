@model LoginViewModel
@{
    ViewData["Title"] = "Вход";
    string? returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="auth-card">
    <h1>Вход</h1>

    @if (!string.IsNullOrEmpty(returnUrl))
    {
        <div class="notice">Чтобы открыть эту страницу, нужно войти.</div>
    }

    <form asp-action="Login" asp-route-returnUrl="@returnUrl" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="validation"></div>

        <label asp-for="Username"></label>
        <input asp-for="Username" autocomplete="username" />
        <span asp-validation-for="Username" class="field-error"></span>

        <label asp-for="Password"></label>
        <input asp-for="Password" autocomplete="current-password" />
        <span asp-validation-for="Password" class="field-error"></span>

        <label class="checkbox">
            <input asp-for="RememberMe" /> @Html.DisplayNameFor(m => m.RememberMe)
        </label>

        <button type="submit" class="btn full">Войти</button>
    </form>

    <p class="muted">Нет аккаунта? <a asp-action="Register">Зарегистрироваться</a></p>
</div>
