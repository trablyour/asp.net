@model BookFormViewModel
@{
    ViewData["Title"] = "Новая книга";
}

<h1>Новая книга</h1>

<form asp-action="Create" method="post" novalidate>
    <div class="card form-card">
        <partial name="_BookForm" model="Model" />
    </div>

    <div class="buttons">
        <button type="submit">Добавить</button>
        <a class="btn secondary" asp-action="Index">Отмена</a>
    </div>
</form>
