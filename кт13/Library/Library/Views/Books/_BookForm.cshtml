@model BookFormViewModel

<label asp-for="Title"></label>
<input asp-for="Title" />
<span asp-validation-for="Title" class="field-error"></span>

<label asp-for="AuthorId"></label>
<select asp-for="AuthorId" asp-items="ViewBag.Authors">
    <option value="0">-- выберите автора --</option>
</select>
<span asp-validation-for="AuthorId" class="field-error"></span>

<div class="grid-2">
    <div>
        <label asp-for="Year"></label>
        <input asp-for="Year" />
        <span asp-validation-for="Year" class="field-error"></span>
    </div>
    <div>
        <label asp-for="Pages"></label>
        <input asp-for="Pages" />
        <span asp-validation-for="Pages" class="field-error"></span>
    </div>
    <div>
        <label asp-for="Genre"></label>
        <input asp-for="Genre" />
        <span asp-validation-for="Genre" class="field-error"></span>
    </div>
    <div>
        <label asp-for="Isbn"></label>
        <input asp-for="Isbn" />
        <span asp-validation-for="Isbn" class="field-error"></span>
    </div>
</div>
