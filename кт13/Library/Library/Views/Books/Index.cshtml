@model List<Book>
@{
    ViewData["Title"] = "Книги";
}

<div class="page-head">
    <h1>Книги</h1>
    <a class="btn" asp-action="Create">+ Добавить книгу</a>
</div>

<form asp-action="Index" method="get" class="filters">
    <input type="text" name="search" value="@ViewBag.Search" placeholder="Поиск по названию" />
    <select name="authorId" asp-items="ViewBag.Authors">
        <option value="">Все авторы</option>
    </select>
    <button type="submit">Найти</button>
    <a class="btn secondary" asp-action="Index">Сбросить</a>
</form>

@if (Model.Count == 0)
{
    <p class="muted">Ничего не найдено.</p>
}
else
{
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Автор</th>
                    <th>Год</th>
                    <th>Жанр</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@book.Id">@book.Title</a></td>
                        <td><a asp-controller="Authors" asp-action="Details" asp-route-id="@book.AuthorId">@book.Author.FullName</a></td>
                        <td>@book.Year</td>
                        <td>@book.Genre</td>
                        <td class="actions">
                            <a asp-action="Edit" asp-route-id="@book.Id">Изменить</a>
                            <a class="danger" asp-action="Delete" asp-route-id="@book.Id">Удалить</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
