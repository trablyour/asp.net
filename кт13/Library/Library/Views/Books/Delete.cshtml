@model Book
@{
    ViewData["Title"] = "Удаление книги";
}

<h1>Удаление книги</h1>

<div class="card form-card">
    <p>Удалить книгу <b>«@Model.Title»</b> (@Model.Author.FullName, @Model.Year)?</p>
    <p class="muted">Автор при этом останется.</p>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <div class="buttons">
            <button type="submit" class="danger-btn">Удалить</button>
            <a class="btn secondary" asp-action="Details" asp-route-id="@Model.Id">Отмена</a>
        </div>
    </form>
</div>
