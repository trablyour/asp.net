{
  "info": {
    "name": "UsersApi",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    }
  ],
  "item": [
    {
      "name": "Все пользователи",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        }
      }
    },
    {
      "name": "Пользователь по id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "1"
          ]
        }
      }
    },
    {
      "name": "Задание 1. Обновить имя, email и возраст",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Иван\",\n  \"email\": \"ivan.new@mail.ru\",\n  \"age\": 26\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Задание 1. Несуществующий пользователь",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "999"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Тест\",\n  \"email\": \"test@mail.ru\",\n  \"age\": 20\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Задание 1. Некорректные данные",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"email\": \"not-an-email\",\n  \"age\": 200\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Задание 2. Имя совпадает",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/2/email",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "2",
            "email"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentName\": \"Анна\",\n  \"newEmail\": \"anna.new@mail.ru\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Задание 2. Имя не совпадает",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/2/email",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "2",
            "email"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentName\": \"Мария\",\n  \"newEmail\": \"maria@mail.ru\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Задание 5. Журнал обновлений",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/logs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "logs"
          ]
        }
      }
    }
  ]
}