@page
@model ImagesModel
@{
    ViewData["Title"] = "Изображения";
}

<h1>Текст с изображениями</h1>
<p class="hint">Картинку можно вставить кнопкой на панели или просто перетащить в редактор. Размер меняется мышкой за углы, положение кнопками выравнивания.</p>

<form method="post">
    <textarea id="editor" name="Text">@Model.Text</textarea>
    <button type="submit">Сохранить</button>
</form>

@if (Model.Message != null)
{
    <p class="msg">@Model.Message</p>
}

<h3>Сохраненный текст:</h3>
<div class="preview">@Html.Raw(Model.Text)</div>

@section Scripts {
    <script src="https://cdn.tiny.cloud/1/tujv09qnzb247xku9uci5xevu3n8yvstlum9fg00ya5w9aqh/tinymce/5/tinymce.min.js" referrerpolicy="origin"></script>
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        tinymce.init({
            selector: '#editor',
            height: 450,
            menubar: false,
            plugins: 'image lists link code',
            toolbar: 'undo redo | bold italic underline | alignleft aligncenter alignright | image | bullist numlist | code',
            image_advtab: true,
            automatic_uploads: true,
            relative_urls: false,
            convert_urls: false,
            file_picker_types: 'image',

            // загрузка картинки на сервер
            images_upload_handler: function (blobInfo, success, failure) {
                const data = new FormData();
                data.append('file', blobInfo.blob(), blobInfo.filename());

                fetch('?handler=Upload', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token },
                    body: data
                })
                    .then(function (r) {
                        if (!r.ok) throw new Error('код ' + r.status);
                        return r.json();
                    })
                    .then(function (json) {
                        success(json.location);
                    })
                    .catch(function (e) {
                        failure('Не удалось загрузить: ' + e.message);
                    });
            }
        });
    </script>
}
