@model CreateUserViewModel
@{
    ViewData["Title"] = "Новый пользователь";
}

<h1>Новый пользователь</h1>

<div class="card narrow">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="validation"></div>

        <label asp-for="FullName"></label>
        <input asp-for="FullName" />
        <span asp-validation-for="FullName" class="field-error"></span>

        <label asp-for="Email"></label>
        <input asp-for="Email" />
        <span asp-validation-for="Email" class="field-error"></span>

        <label asp-for="Role"></label>
        <select asp-for="Role" asp-items="@(new SelectList(Roles.All))"></select>
        <span asp-validation-for="Role" class="field-error"></span>

        <label asp-for="Password"></label>
        <input asp-for="Password" />
        <span asp-validation-for="Password" class="field-error"></span>

        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" />
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>

        <div class="buttons">
            <button type="submit">Создать</button>
            <a class="btn secondary" asp-action="Index">Отмена</a>
        </div>
    </form>
</div>
