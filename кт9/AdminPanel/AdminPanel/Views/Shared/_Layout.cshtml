@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthService
@inject AdminPanel.Services.SiteSettings Settings
@{
    bool isAdmin = (await AuthService.AuthorizeAsync(User, Policies.AdminOnly)).Succeeded;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Settings.SiteName</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">@Settings.SiteName</a>

        <nav class="topnav">
            <a asp-area="" asp-controller="Home" asp-action="Index">Главная</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-area="" asp-controller="Home" asp-action="Profile">Профиль</a>
            }
            @if (isAdmin)
            {
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Админ-панель</a>
            }
        </nav>

        <div class="userbox">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span>@User.Identity.Name</span>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="inline-form">
                    <button type="submit" class="link-btn">Выйти</button>
                </form>
            }
            else
            {
                <a asp-area="" asp-controller="Account" asp-action="Login">Войти</a>
                <a asp-area="" asp-controller="Account" asp-action="Register">Регистрация</a>
            }
        </div>
    </header>

    <main class="page">
        @RenderBody()
    </main>
</body>
</html>
