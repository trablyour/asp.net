@model Teacher
@{
    ViewData["Title"] = "Удаление преподавателя";
    int enrollments = Model.Courses.Sum(c => c.Enrollments.Count);
}

<h1>Удаление преподавателя</h1>

<div class="card form-card">
    <p>Удалить преподавателя <b>@Model.FullName</b>?</p>

    @if (Model.Courses.Count > 0)
    {
        <div class="alert warning">
            Каскадное удаление: будут удалены курсы преподавателя (@Model.Courses.Count)
            и все записи студентов на них (@enrollments):
            <ul>
                @foreach (var c in Model.Courses)
                {
                    <li>@c.Title (студентов: @c.Enrollments.Count)</li>
                }
            </ul>
        </div>
    }

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <div class="buttons">
            <button type="submit" class="danger-btn">Удалить</button>
            <a class="btn secondary" asp-action="Details" asp-route-id="@Model.Id">Отмена</a>
        </div>
    </form>
</div>
