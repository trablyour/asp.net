@model StudentFormViewModel

<div class="grid-2">
    <div>
        <label asp-for="LastName"></label>
        <input asp-for="LastName" />
        <span asp-validation-for="LastName" class="field-error"></span>
    </div>
    <div>
        <label asp-for="FirstName"></label>
        <input asp-for="FirstName" />
        <span asp-validation-for="FirstName" class="field-error"></span>
    </div>
    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" />
        <span asp-validation-for="Email" class="field-error"></span>
    </div>
    <div>
        <label asp-for="Group"></label>
        <input asp-for="Group" />
        <span asp-validation-for="Group" class="field-error"></span>
    </div>
</div>
