@model Course
@{
    ViewData["Title"] = "Удаление курса";
}

<h1>Удаление курса</h1>

<div class="card form-card">
    <p>Удалить курс <b>«@Model.Title»</b> (преподаватель @Model.Teacher.FullName)?</p>

    @if (Model.Enrollments.Count > 0)
    {
        <div class="alert warning">
            Каскадное удаление: будут удалены записи студентов на этот курс (@Model.Enrollments.Count).
            Сами студенты останутся.
        </div>
    }

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <div class="buttons">
            <button type="submit" class="danger-btn">Удалить</button>
            <a class="btn secondary" asp-action="Details" asp-route-id="@Model.Id">Отмена</a>
        </div>
    </form>
</div>
