            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"Annet\",\n  \"email\": \"annet@mail.ru\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Удалить пользователя",
