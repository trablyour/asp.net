@model CryptoViewModel

@if (Model.Error != null)
{
    <div class="alert error">@Model.Error</div>
}
@if (Model.Message != null)
{
    <div class="alert success">@Model.Message</div>
}

<form asp-action="Index" method="post">
    <div class="card">
        <label asp-for="Key">Ключ (Base64)</label>
        <div class="key-row">
            <input asp-for="Key" class="mono" placeholder="можно оставить пустым, ключ сгенерируется при шифровании" />
            <button type="submit" name="command" value="generate" class="secondary">Сгенерировать</button>
        </div>
    </div>

    <div class="columns">
        <div class="card">
            <h2>Шифрование</h2>
            <label asp-for="PlainText">Исходный текст</label>
            <textarea asp-for="PlainText" rows="6"></textarea>
            <button type="submit" name="command" value="encrypt">Зашифровать</button>
        </div>

        <div class="card">
            <h2>Дешифрование</h2>
            <label asp-for="CipherText">Зашифрованный текст (Base64)</label>
            <textarea asp-for="CipherText" rows="6" class="mono"></textarea>
            <button type="submit" name="command" value="decrypt">Расшифровать</button>

            <label asp-for="DecryptedText">Результат</label>
            <textarea asp-for="DecryptedText" rows="4" readonly></textarea>
        </div>
    </div>
</form>
